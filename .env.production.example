# Use: python scripts/prepare-production.py --domain your-real-domain
# This example contains no working secrets. The generator writes .env.production.
APP_DOMAIN=afisha.example.com
POSTGRES_PASSWORD=
ADMIN_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FREE=false
LLM_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=700
# Actual provider prices in RUB per million tokens; unknown tariffs disable paid calls.
LLM_INPUT_RUB_PER_MILLION=0
LLM_OUTPUT_RUB_PER_MILLION=0
LLM_TURN_BUDGET_RUB=1
LLM_DIALOGUE_BUDGET_RUB=3
LLM_DAILY_BUDGET_RUB=20
ROUTE_API_URL=
NOTIFICATION_DAILY_LIMIT=3
NOTIFICATION_QUIET_START=22
NOTIFICATION_QUIET_END=9
NOTIFICATION_INTERVAL_SECONDS=60
RETENTION_DAYS=30
