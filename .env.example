DATABASE_URL=postgresql+asyncpg://bashculture:local-dev-only@localhost:55432/bashculture
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=55432
API_PORT=8000
# Сгенерируйте случайный ключ перед использованием административного API.
# Пустой ключ полностью отключает доступ к административным маршрутам.
ADMIN_API_TOKEN=
EVENT_TIMEZONE=Asia/Yekaterinburg
MAX_IMPORT_BYTES=2097152
MAX_IMPORT_ROWS=2000

# Уровни 1 и 4. Пустой токен оставляет бот отключённым, каталог работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# OSRM-compatible автомобильный endpoint. Пусто — переезд между площадками неизвестен.
ROUTE_API_URL=
NOTIFICATION_DAILY_LIMIT=3
NOTIFICATION_QUIET_START=22
NOTIFICATION_QUIET_END=9
NOTIFICATION_INTERVAL_SECONDS=60
RETENTION_DAYS=30

# Сайт и сессии. Для HTTPS установите SESSION_SECURE_COOKIE=true.
WEB_PORT=8081
PUBLIC_BASE_URL=http://localhost:8081
SESSION_SECURE_COOKIE=false
# Полный адрес endpoint tool calling. Без настроек работает обычный поиск.
LLM_API_URL=
LLM_API_KEY=
LLM_REQUIRE_API_KEY=false
LLM_MODEL=
LLM_FREE=false
LLM_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=700
# Рубли за миллион токенов. Нулевая цена без LLM_FREE не разрешает платные вызовы.
LLM_INPUT_RUB_PER_MILLION=0
LLM_OUTPUT_RUB_PER_MILLION=0
LLM_TURN_BUDGET_RUB=1
LLM_DIALOGUE_BUDGET_RUB=3
LLM_DAILY_BUDGET_RUB=20
